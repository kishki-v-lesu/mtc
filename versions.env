# =============================================================================
# ЕДИНЫЙ ИСТОЧНИК ВЕРСИЙ
# Все версии зафиксированы для воспроизводимости. Меняйте только здесь.
# =============================================================================

# --- Kubernetes ---------------------------------------------------------------
KUBERNETES_VERSION="1.37.1"
# Минорная версия для apt-репозитория pkgs.k8s.io (используется как v${KUBERNETES_MINOR})
KUBERNETES_MINOR="1.37"
# Версия образа узла для kind (только для E2E-прогона, не для kubeadm).
# Отдельно от KUBERNETES_VERSION по двум причинам:
#  1) образов kindest/node на каждую патч-версию Kubernetes не существует:
#     тега kindest/node:v1.37.1 в Docker Hub нет (есть v1.37.0);
#  2) на kindest/node:v1.37.0 kube-apiserver в этой среде нестабилен:
#     процесс завершается с кодом 255 через ~40-90 c после старта
#     (проверено, 9 рестартов подряд). v1.36.4 ведёт себя стабильно.
KIND_NODE_VERSION="1.36.4"

# --- CNI (Calico) -------------------------------------------------------------
# Calico выбран потому, что умеет enforced NetworkPolicy (flannel не умеет).
CALICO_VERSION="v3.33.0"
CALICO_MANIFEST_URL="https://raw.githubusercontent.com/projectcalico/calico/${CALICO_VERSION}/manifests/calico.yaml"

# --- Storage provisioner (обязателен для PVC в kubeadm-кластере) ---------------
LOCAL_PATH_PROVISIONER_VERSION="v0.0.37"
LOCAL_PATH_MANIFEST_URL="https://raw.githubusercontent.com/rancher/local-path-provisioner/${LOCAL_PATH_PROVISIONER_VERSION}/deploy/local-path-storage.yaml"

# --- Gateway API --------------------------------------------------------------
# Версия зафиксирована по матрице совместимости NGINX Gateway Fabric 2.7.2
# (NGF 2.7.2 -> Gateway API 1.6.1, Kubernetes 1.32+).
GATEWAY_API_VERSION="v1.6.1"
GATEWAY_API_CHANNEL="standard"
GATEWAY_API_RELEASE_BASE="https://github.com/kubernetes-sigs/gateway-api/releases/download"

# --- NGINX Gateway Fabric (Gateway API implementation) ------------------------
NGF_RELEASE_NAME="ngf"
NGF_CHART_VERSION="2.7.2"
NGF_CHART_REPO="oci://ghcr.io/nginx/charts/nginx-gateway-fabric"

# --- Monitoring ---------------------------------------------------------------
KPS_RELEASE_NAME="kube-prometheus-stack"
KPS_CHART_VERSION="91.9.0"
KPS_CHART_REPO="https://prometheus-community.github.io/helm-charts"

# --- Container images ---------------------------------------------------------
NGINX_IMAGE="nginxinc/nginx-unprivileged:1.29.4-alpine"
# Репозиторий переехал в организацию nginx, тег без префикса v:
# https://hub.docker.com/r/nginx/nginx-prometheus-exporter/tags
NGINX_EXPORTER_IMAGE="nginx/nginx-prometheus-exporter:1.5.3"
FILEBEAT_IMAGE="docker.elastic.co/beats/filebeat:9.5.4"
ELASTICSEARCH_IMAGE="docker.elastic.co/elasticsearch/elasticsearch:9.5.4"
# Kibana не входит в путь развёртывания по умолчанию (не хватает ~1 ГБ RAM),
# но образ тоже зафиксирован, чтобы make kibana был воспроизводим.
KIBANA_IMAGE="docker.elastic.co/kibana/kibana:9.5.4"

# --- Namespaces ---------------------------------------------------------------
APP_NAMESPACE="mtc-demo"
GATEWAY_NAMESPACE="nginx-gateway"
MONITORING_NAMESPACE="monitoring"

# --- Network ------------------------------------------------------------------
# Фиксированный NodePort, чтобы проверка через curl была детерминированной.
APP_NODEPORT="30080"
# Порт listener'а в Gateway, на который маппится NodePort (listener HTTP в Gateway
# из deploy/gateway/gateway.yaml). Должен совпадать со значением ports[].port.
NGF_LISTENER_PORT="80"
# CIDR, которым доверен входящий трафик к Gateway (NetworkPolicy).
GATEWAY_ALLOWED_CIDR="0.0.0.0/0"

# --- Приложение ---------------------------------------------------------------
APP_REPLICAS="3"
ES_HEAP="1g"
