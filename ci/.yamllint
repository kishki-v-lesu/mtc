---
# Конфигурация yamllint для проекта.
# Цель — единый стиль и отсутствие «невидимых» проблем в YAML, а не
# соответствие какому-либо готовому стилю.

extends: default

rules:
  # Отступы: 2 пробела (Kubernetes-конвенция)
  indentation:
    spaces: 2
    indent-sequences: consistent

  # Длина строки: в ConfigMap с конфигурацией NGINX строки бывают длинными
  line-length:
    max: 160
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true

  # Не требуем начинать документ с '---'
  document-start:
    present: true

  # Пробелы после двоеточия обязательны, перед — нет
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1

  # Не ограничиваем число логов документа
  document-end: disable

  # Не запрещаем 'yes'/'no' в значениях (Kustomize использует их осмысленно)
  truthy:
    allowed-values: ["true", "false", "on", "off"]
    check-keys: false

  comments:
    require-starting-space: true
    min-spaces-from-content: 1

# Trailing spaces — ошибка (правило включено с настройками по умолчанию)